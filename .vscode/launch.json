      // "cwd": "${workspaceFolder}",
      // "console": "internalConsole",
      // "launchSettingsFilePath": "${workspaceFolder}/src/YourApp/Properties/launchSettings.json",
      // "launchSettingsProfile": "Sample"
    }
  ]
}